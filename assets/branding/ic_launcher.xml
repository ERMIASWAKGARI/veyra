<?xml version="1.0" encoding="utf-8"?>
<!--
  Place this file at: android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
  (and a copy as ic_launcher_round.xml)
  Drop the matching PNGs from adaptive-icon/ into
  res/mipmap-mdpi, res/mipmap-hdpi, res/mipmap-xhdpi, res/mipmap-xxhdpi, res/mipmap-xxxhdpi
  as ic_launcher_foreground.png and ic_launcher_background.png in each.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
