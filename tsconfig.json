{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "types": [
      "react"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "app/**/*.jsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "dist"
  ]
}
